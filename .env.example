# Vector-Mind Map-Fusion 环境变量模板
#
# ⚠️ 前置要求（必须先安装）：
#    1. 安装 Ollama: https://ollama.com
#    2. 拉取模型: ollama pull bge-m3
#    3. 启动服务: ollama serve
#

# ===== OpenClaw 会话目录 =====
SESSIONS_DIR=~/.openclaw/agents/main/sessions

# ===== Ollama 向量模型（必须）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=bge-m3

# ===== Neural Memory 数据库 =====
NEURALMEMORY_DIR=~/.local/share/neural-memory
BRAIN_DB_PATH=${NEURALMEMORY_DIR}/brains.db

# ===== 数据路径 =====
L2A_DIR=/workspace/vector-mind-map-fusion/memory/layers/l2a
L2_DIR=/workspace/vector-mind-map-fusion/memory/layers/l2
HNSW_DIR=/workspace/vector-mind-map-fusion/memory/layers/hnsw
INFINITYDB_DIR=/workspace/vector-mind-map-fusion/memory/layers/infinitydb

# ===== 定时任务（Asia/Shanghai）=====
# L1+L2: 每天 00:30
# L3: 每两天 03:00

# ===== 可选：日志级别 =====
LOG_LEVEL=INFO